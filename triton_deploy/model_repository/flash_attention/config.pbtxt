name: "flash_attention"
backend: "python"
max_batch_size: 0

input [
  {
    name: "Q"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  },
  {
    name: "K"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  },
  {
    name: "V"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  }
]

output [
  {
    name: "O"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
